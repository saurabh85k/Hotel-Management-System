<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Guests_Greater_Than_Zero</fullName>
    <active>true</active>
    <errorConditionFormula>Number_of_Guests__c &lt;= 0</errorConditionFormula>
    <errorDisplayField>Number_of_Guests__c</errorDisplayField>
    <errorMessage>Number of Guests must be greater than 0.</errorMessage>
</ValidationRule>
