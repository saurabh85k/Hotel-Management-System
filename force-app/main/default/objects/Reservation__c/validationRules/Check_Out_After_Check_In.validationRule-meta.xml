<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Check_Out_After_Check_In</fullName>
    <active>true</active>
    <errorConditionFormula>Check_Out_Date__c &lt;=  Check_In_Date__c</errorConditionFormula>
    <errorDisplayField>Check_Out_Date__c</errorDisplayField>
    <errorMessage>Check-Out Date must be after Check-In Date.</errorMessage>
</ValidationRule>
